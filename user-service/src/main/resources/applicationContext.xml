<?xml version="1.0" encoding="UTF-8"?>

<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
       http://www.springframework.org/schema/beans
       http://www.springframework.org/schema/beans/spring-beans.xsd">


       <bean id="dataSource"
              class="org.springframework.jdbc.datasource.DriverManagerDataSource">

              <property name="driverClassName"
                            value="com.mysql.cj.jdbc.Driver"/>

              <property name="url"
                            value="jdbc:mysql://user-db:3306/userdb"/>

              <property name="username"
                            value="appuser"/>

              <property name="password"
                            value="apppassword"/>

       </bean>

       <bean id="databaseTest"
      class="com.enterprise.todo.config.DatabaseTest"
      init-method="testConnection">
              <property name="dataSource" ref="dataSource"/>

       </bean>
       <bean id="userRepository"
              class="com.enterprise.todo.repository.UserRepositoryImpl">
              <property name="dataSource" ref="dataSource"/>
       </bean>

       <bean id="userService"
              class="com.enterprise.todo.service.UserServiceImpl">
              <property name="userRepository" ref="userRepository"/>
              <property name="passwordEncoder" ref="passwordEncoder"/>
       </bean>
       <bean id="passwordEncoder"
              class="org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder"/>
</beans>